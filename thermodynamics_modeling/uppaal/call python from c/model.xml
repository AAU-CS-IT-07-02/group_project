<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>// global declarations
int x = 20;
const int low = 14;
const int high = 28;
bool actuator = false;</declaration>
	<template>
		<name>SimpleAutomaton</name>
		<declaration>// local declarations</declaration>
		<location id="id0" x="-8" y="0">
			<name x="-18" y="-34">Off</name>
		</location>
		<location id="id1" x="408" y="0">
			<name x="398" y="-34">On</name>
		</location>
		<init ref="id0"/>
		<transition id="id2">
			<source ref="id1"/>
			<target ref="id0"/>
			<label kind="guard" x="153" y="-144">x &gt;= high</label>
			<label kind="assignment" x="119" y="-110">actuator = false</label>
			<nail x="280" y="-119"/>
			<nail x="93" y="-119"/>
		</transition>
		<transition id="id3">
			<source ref="id1"/>
			<target ref="id1"/>
			<label kind="assignment" x="383" y="59">x = x + 1</label>
			<nail x="442" y="59"/>
			<nail x="365" y="59"/>
		</transition>
		<transition id="id4">
			<source ref="id0"/>
			<target ref="id0"/>
			<label kind="assignment" x="-16" y="59">x = x - 1</label>
			<nail x="34" y="59"/>
			<nail x="-34" y="59"/>
		</transition>
		<transition id="id5">
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="guard" x="153" y="-34">x &lt;= low</label>
			<label kind="assignment" x="119" y="8">actuator = true</label>
		</transition>
	</template>
	<system>Process = SimpleAutomaton();
system SimpleAutomaton;</system>
	<queries>
		<query>
			<formula/>
			<comment/>
		</query>
	</queries>
</nta>
